rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-from-Firestore approach (documented as the fallback in the brief,
    // since custom claims require a Cloud Function on user creation).
    // If you later add a Cloud Function to set a custom claim, swap this
    // for: request.auth.token.role == 'admin'
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function unchangedRole() {
      return request.resource.data.role == resource.data.role;
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Creation: only the user themself, and role must be "customer".
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      // Update: owner can update their own fields but can NEVER change role.
      // Admin can update anything (e.g. to promote a user manually).
      allow update: if (isOwner(userId) && unchangedRole()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- services ----------
    match /services/{serviceId} {
      allow read: if true; // public catalog
      allow write: if isAdmin();
    }

    // ---------- appointments ----------
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Customers may only cancel their own PENDING appointment.
      // Admins may confirm/cancel/complete following the same state machine
      // enforced in utils/appointmentRules.js on the client.
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled'
      );

      allow delete: if false; // appointments are never hard-deleted
    }

    // ---------- inquiries ----------
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin(); // only admin changes status (open/in-progress/resolved)
      allow delete: if isAdmin();
    }

    // ---------- testimonials ----------
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- projects (our work) ----------
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
